#include "mpu9250.h"

Mag_Data mag;

void mag_init(I2C_HandleTypeDef *hi2c)
{
    uint8_t id;
    HAL_I2C_Mem_Read(hi2c, AK8963_ADDR, AK8963_WHO_AM_I, I2C_MEMADD_SIZE_8BIT, &id, 1, HAL_MAX_DELAY);
    if(id != 0x48) {
        printf("Magnetometer not detected! ID=0x%02X\r\n", id);
        return;
    }
    printf("Magnetometer detected! ID=0x%02X\r\n", id);

    // Set magnetometer to continuous measurement mode 2 (100Hz)
    HAL_I2C_Mem_Write(hi2c, AK8963_ADDR, AK8963_CNTL1, I2C_MEMADD_SIZE_8BIT, (uint8_t[]){0x16}, 1, HAL_MAX_DELAY);
    HAL_Delay(10);
}

void mag_read(I2C_HandleTypeDef *hi2c)
{
    uint8_t st1;
    HAL_I2C_Mem_Read(hi2c, AK8963_ADDR, AK8963_ST1, I2C_MEMADD_SIZE_8BIT, &st1, 1, HAL_MAX_DELAY);
    if(st1 & 0x01) { // Data ready
        uint8_t raw[7];
        HAL_I2C_Mem_Read(hi2c, AK8963_ADDR, AK8963_XOUT_L, I2C_MEMADD_SIZE_8BIT, raw, 7, HAL_MAX_DELAY);
        mag.mx = (raw[2]<<8) | raw[1];
        mag.my = (raw[4]<<8) | raw[3];
        mag.mz = (raw[6]<<8) | raw[5];
    }
}
