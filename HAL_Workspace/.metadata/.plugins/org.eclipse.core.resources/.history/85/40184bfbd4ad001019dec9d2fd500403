#include "ultrasonic.h"

// TIM handle generated by CubeMX
extern TIM_HandleTypeDef htim2;

// Variables for echo measurement
volatile uint32_t ic_rising = 0;
volatile uint32_t ic_falling = 0;
volatile uint32_t distance_cm = 0;
volatile uint8_t object_near_flag = 0;

// Init function: start PWM trigger + input capture interrupt
void Ultrasonic_Init(void)
{
    HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_1);     // PWM trigger
    HAL_TIM_IC_Start_IT(&htim2, TIM_CHANNEL_2);  // Echo capture
}

// Return last measured distance
uint32_t Ultrasonic_GetDistance(void)
{
    return distance_cm;
}

// Called by HAL on each capture event (rising/falling edge)
void HAL_TIM_IC_CaptureCallback(TIM_HandleTypeDef *htim)
{
    if(htim->Instance == TIM2 && htim->Channel == HAL_TIM_ACTIVE_CHANNEL_2)
    {
        static uint8_t is_rising = 1;

        if (is_rising)
        {
            ic_rising = HAL_TIM_ReadCapturedValue(htim, TIM_CHANNEL_2);
            __HAL_TIM_SET_CAPTUREPOLARITY(htim, TIM_CHANNEL_2, TIM_INPUTCHANNELPOLARITY_FALLING);
            is_rising = 0;
        }
        else
        {
            ic_falling = HAL_TIM_ReadCapturedValue(htim, TIM_CHANNEL_2);
            __HAL_TIM_SET_CAPTUREPOLARITY(htim, TIM_CHANNEL_2, TIM_INPUTCHANNELPOLARITY_RISING);
            is_rising = 1;

            if (ic_falling > ic_rising)
                distance_cm = (ic_falling - ic_rising) * 0.0343 / 2;
            else
                distance_cm = 0;
            printf("Captured: %lu -> %lu, distance=%lu cm\r\n", ic_rising, ic_falling, distance_cm);
            if (distance_cm < DISTANCE_THRESHOLD)
            {
                HAL_GPIO_WritePin(LED_PORT, LED_PIN, GPIO_PIN_SET);
                object_near_flag = 1;
            }
            else
            {
                HAL_GPIO_WritePin(LED_PORT, LED_PIN, GPIO_PIN_RESET);
                object_near_flag = 0;
            }
        }
    }
}
