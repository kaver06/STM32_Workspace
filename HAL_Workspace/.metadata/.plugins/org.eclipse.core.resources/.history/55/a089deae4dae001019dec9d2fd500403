#include "ultrasonic.h"

// TIM handle generated by CubeMX
extern TIM_HandleTypeDef htim2;

// === Sensor 1 Variables (CH1 trigger, CH2 echo) ===
#define BUFFER_SIZE 2
volatile uint32_t ic_values1[BUFFER_SIZE] = {0};
volatile uint32_t ic_values2[BUFFER_SIZE] = {0};

volatile uint32_t distance1_cm = 0;
volatile uint32_t distance2_cm = 0;
volatile uint8_t object1_near_flag = 0;
volatile uint8_t object2_near_flag = 0;

// Init function: start PWM trigger + input capture DMA
void Ultrasonic_Init(void)
{
    // Start PWM trigger channels
    HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_1); // Sensor 1 trigger
    HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_3); // Sensor 2 trigger

    // Start Input Capture with DMA for both sensors
    HAL_TIM_IC_Start_DMA(&htim2, TIM_CHANNEL_2, (uint32_t*)ic_values1, 2); // Sensor 1 echo
    HAL_TIM_IC_Start_DMA(&htim2, TIM_CHANNEL_4, (uint32_t*)ic_values2, 2); // Sensor 2 echo
}

// Distance access
uint32_t Ultrasonic1_GetDistance(void) { return distance1_cm; }
uint32_t Ultrasonic2_GetDistance(void) { return distance2_cm; }

// Process DMA-captured values
void Ultrasonic_Process(void)
{
    // Sensor 1
    if(ic_values1[1] > ic_values1[0])
    {
        distance1_cm = (ic_values1[1] - ic_values1[0]) * 0.0343 / 2;
        object1_near_flag = (distance1_cm < DISTANCE_THRESHOLD) ? 1 : 0;
        HAL_GPIO_WritePin(LED1_PORT, LED1_PIN, object1_near_flag);
    }

    // Sensor 2
    if(ic_values2[1] > ic_values2[0])
    {
        distance2_cm = (ic_values2[1] - ic_values2[0]) * 0.0343 / 2;
        object2_near_flag = (distance2_cm < DISTANCE_THRESHOLD) ? 1 : 0;
        HAL_GPIO_WritePin(LED2_PORT, LED2_PIN, object2_near_flag);
    }
}
