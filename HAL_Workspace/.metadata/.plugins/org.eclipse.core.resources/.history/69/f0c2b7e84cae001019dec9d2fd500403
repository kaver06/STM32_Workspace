#include "ultrasonic.h"

// TIM handle generated by CubeMX
extern TIM_HandleTypeDef htim2;


// === Sensor 1 Variables (CH1 → trigger, CH2 → echo) ===
volatile uint32_t ic1_rising = 0;
volatile uint32_t ic1_falling = 0;
volatile uint32_t distance1_cm = 0;
volatile uint8_t object1_near_flag = 0;

// === Sensor 2 Variables (CH3 → trigger, CH4 → echo) ===
volatile uint32_t ic2_rising = 0;
volatile uint32_t ic2_falling = 0;
volatile uint32_t distance2_cm = 0;
volatile uint8_t object2_near_flag = 0;


// Init function: start PWM trigger + input capture interrupt
void Ultrasonic_Init(void)
{
    // Start PWM trigger channels
    HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_1); // Sensor 1 trigger
    HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_3); // Sensor 2 trigger

    // Start Input Capture with interrupt for both echo pins
    HAL_TIM_IC_Start_IT(&htim2, TIM_CHANNEL_2); // Sensor 1 echo
    HAL_TIM_IC_Start_IT(&htim2, TIM_CHANNEL_4); // Sensor 2 echo
}

// === Distance Access ===
uint32_t Ultrasonic1_GetDistance(void) { return distance1_cm; }
uint32_t Ultrasonic2_GetDistance(void) { return distance2_cm; }


// === Capture Callback ===
void HAL_TIM_IC_CaptureCallback(TIM_HandleTypeDef *htim)
{
    // Sensor 1: CH2 Echo
    if(htim->Instance == TIM2 && htim->Channel == HAL_TIM_ACTIVE_CHANNEL_2)
    {
        GPIO_PinState echoState = HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_8); // Echo1
        if(echoState == GPIO_PIN_SET)  // Rising edge
        {
            ic1_rising = HAL_TIM_ReadCapturedValue(htim, TIM_CHANNEL_2);
        }
        else                           // Falling edge
        {
            ic1_falling = HAL_TIM_ReadCapturedValue(htim, TIM_CHANNEL_2);
            if(ic1_falling > ic1_rising)
                distance1_cm = (ic1_falling - ic1_rising) * 0.0343 / 2;
            else
                distance1_cm = 0;

            // LED + Flag
            if(distance1_cm < DISTANCE_THRESHOLD && distance1_cm > 0)
            {
                HAL_GPIO_WritePin(LED1_PORT, LED1_PIN, GPIO_PIN_SET);
                object1_near_flag = 1;
            }
            else
            {
                HAL_GPIO_WritePin(LED1_PORT, LED1_PIN, GPIO_PIN_RESET);
                object1_near_flag = 0;
            }
        }
    }

    // Sensor 2: CH4 Echo
    else if(htim->Instance == TIM2 && htim->Channel == HAL_TIM_ACTIVE_CHANNEL_4)
    {
        GPIO_PinState echoState = HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_9); // Echo2
        if(echoState == GPIO_PIN_SET)  // Rising edge
        {
            ic2_rising = HAL_TIM_ReadCapturedValue(htim, TIM_CHANNEL_4);
        }
        else                           // Falling edge
        {
            ic2_falling = HAL_TIM_ReadCapturedValue(htim, TIM_CHANNEL_4);
            if(ic2_falling > ic2_rising)
                distance2_cm = (ic2_falling - ic2_rising) * 0.0343 / 2;
            else
                distance2_cm = 0;

            // LED + Flag
            if(distance2_cm < DISTANCE_THRESHOLD && distance2_cm > 0)
            {
                HAL_GPIO_WritePin(LED2_PORT, LED2_PIN, GPIO_PIN_SET);
                object2_near_flag = 1;
            }
            else
            {
                HAL_GPIO_WritePin(LED2_PORT, LED2_PIN, GPIO_PIN_RESET);
                object2_near_flag = 0;
            }
        }
    }
}
