#ifndef INC_MPU9250_H_
#define INC_MPU9250_H_

#include "stm32f4xx_hal.h"
#include <stdio.h>
#include <math.h>

#define MPU9250_ADDR        (0x68 << 1)
#define AK8963_ADDR         (0x0C << 1)

#define ACCEL_XOUT_H_REG    0x3B
#define GYRO_XOUT_H_REG     0x43
#define INT_PIN_CFG         0x37
#define PWR_MGMT_1_REG      0x6B
#define WHO_AM_I_REG        0x75

#define AK8963_CNTL1        0x0A
#define AK8963_ST1          0x02
#define AK8963_XOUT_L       0x03
#define AK8963_WHO_AM_I     0x00

typedef struct {
    float ax, ay, az;
    float gx, gy, gz;
    int16_t mx, my, mz;
    float pitch, roll, yaw;
} MPU9250_Data;

extern MPU9250_Data imu;
extern uint8_t mpu_raw[14];
extern uint8_t mag_raw[7];

void mpu9250_init(I2C_HandleTypeDef *hi2c);
void mpu9250_read_accel_gyro(I2C_HandleTypeDef *hi2c);
void mpu9250_read_mag(I2C_HandleTypeDef *hi2c);
void mpu9250_compute_orientation(void);

#endif /* INC_MPU9250_H_ */
