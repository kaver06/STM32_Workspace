#include "encoder.h"

static int32_t left_count = 0;
static int32_t right_count = 0;

void Encoder_Init(void)
{
    // Start timers in encoder interface mode with interrupt
    HAL_TIM_Encoder_Start_IT(&htim4, TIM_CHANNEL_ALL);
    HAL_TIM_Encoder_Start_IT(&htim5, TIM_CHANNEL_ALL);
}

// Callbacks from CubeMX timer IRQ
void HAL_TIM_IC_CaptureCallback(TIM_HandleTypeDef *htim)
{
    // Not needed in basic encoder, counts handled by CNT register
}

int32_t Encoder_GetLeft(void)
{
    left_count = (int32_t) __HAL_TIM_GET_COUNTER(&htim4);
    return left_count;
}

int32_t Encoder_GetRight(void)
{
    right_count = (int32_t) __HAL_TIM_GET_COUNTER(&htim5);
    return right_count;
}

void Encoder_Reset(void)
{
    __HAL_TIM_SET_COUNTER(&htim4, 0);
    __HAL_TIM_SET_COUNTER(&htim5, 0);
}

