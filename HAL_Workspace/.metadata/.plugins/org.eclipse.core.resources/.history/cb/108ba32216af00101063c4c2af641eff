
#include "mpu9250.h"


extern I2C_HandleTypeDef hi2c1; // Use your configured I2C handle

MPU9250_Data imu = {0};

static float mag_adjust[3];

HAL_StatusTypeDef mpu9250_write(uint8_t reg, uint8_t data) {
    return HAL_I2C_Mem_Write(&hi2c1, MPU9250_ADDR, reg, 1, &data, 1, HAL_MAX_DELAY);
}

HAL_StatusTypeDef mpu9250_read_bytes(uint8_t reg, uint8_t *data, uint8_t len) {
    return HAL_I2C_Mem_Read(&hi2c1, MPU9250_ADDR, reg, 1, data, len, HAL_MAX_DELAY);
}

HAL_StatusTypeDef ak8963_write(uint8_t reg, uint8_t data) {
    return HAL_I2C_Mem_Write(&hi2c1, AK8963_ADDR, reg, 1, &data, 1, HAL_MAX_DELAY);
}

HAL_StatusTypeDef ak8963_read_bytes(uint8_t reg, uint8_t *data, uint8_t len) {
    return HAL_I2C_Mem_Read(&hi2c1, AK8963_ADDR, reg, 1, data, len, HAL_MAX_DELAY);
}

// ---- Initialization ----
void mpu9250_init(void) {
    uint8_t check;
    HAL_StatusTypeDef ret;

    // Check MPU9250 WHO_AM_I
    ret = mpu9250_read_bytes(WHO_AM_I_REG, &check, 1);
    if (ret == HAL_OK && check == 0x71) {
        printf("MPU9250 detected!\r\n");
    } else {
        printf("MPU9250 not found!\r\n");
        return;
    }

    // Wake up
    mpu9250_write(PWR_MGMT_1_REG, 0x00);
    HAL_Delay(100);

    // Configure Gyro and Accel
    mpu9250_write(GYRO_CONFIG_REG, 0x00);
    mpu9250_write(ACCEL_CONFIG_REG, 0x00);

    // Enable I2C bypass to access magnetometer
    mpu9250_write(INT_PIN_CFG, 0x02);
    HAL_Delay(10);

    // ---- Initialize AK8963 magnetometer ----
    ret = ak8963_write(AK8963_CNTL1, 0x00); // Power down
    HAL_Delay(10);
    ret = ak8963_write(AK8963_CNTL1, 0x0F); // Fuse ROM access mode
    HAL_Delay(10);

    uint8_t asa[3];
    ak8963_read_bytes(AK8963_ASAX, asa, 3);
    for (int i = 0; i < 3; i++)
        mag_adjust[i] = ((asa[i] - 128) / 256.0f) + 1.0f;

    ak8963_write(AK8963_CNTL1, 0x00); // Power down
    HAL_Delay(10);
    ak8963_write(AK8963_CNTL1, 0x16); // 16-bit, continuous measurement mode 2 (100Hz)
    HAL_Delay(10);

    printf("MPU9250 + AK8963 initialized!\r\n");
}

// ---- Reading function ----
void mpu9250_read(void) {
    uint8_t raw[14];
    if (mpu9250_read_bytes(ACCEL_XOUT_H_REG, raw, 14) != HAL_OK)
        return;

    // Convert accel and gyro
    int16_t ax = (raw[0] << 8) | raw[1];
    int16_t ay = (raw[2] << 8) | raw[3];
    int16_t az = (raw[4] << 8) | raw[5];
    int16_t gx = (raw[8] << 8) | raw[9];
    int16_t gy = (raw[10] << 8) | raw[11];
    int16_t gz = (raw[12] << 8) | raw[13];

    imu.ax = ax / 16384.0f;
    imu.ay = ay / 16384.0f;
    imu.az = az / 16384.0f;
    imu.gx = gx / 131.0f;
    imu.gy = gy / 131.0f;
    imu.gz = gz / 131.0f;

    // ---- Read magnetometer ----
    uint8_t mag_data[7];
    if (ak8963_read_bytes(AK8963_ST1, mag_data, 7) == HAL_OK && (mag_data[0] & 0x01)) {
        int16_t mx = (mag_data[2] << 8) | mag_data[1];
        int16_t my = (mag_data[4] << 8) | mag_data[3];
        int16_t mz = (mag_data[6] << 8) | mag_data[5];

        imu.mx = mx * mag_adjust[0] * 0.15f;
        imu.my = my * mag_adjust[1] * 0.15f;
        imu.mz = mz * mag_adjust[2] * 0.15f;
    }

    // ---- Compute orientation ----
    imu.pitch = atan2f(imu.ay, sqrtf(imu.ax * imu.ax + imu.az * imu.az)) * 57.2958f;
    imu.roll  = atan2f(-imu.ax, imu.az) * 57.2958f;

    float pitch_rad = imu.pitch * (M_PI / 180.0f);
    float roll_rad  = imu.roll * (M_PI / 180.0f);

    float mag_x_comp = imu.mx * cosf(pitch_rad) + imu.mz * sinf(pitch_rad);
    float mag_y_comp = imu.mx * sinf(roll_rad) * sinf(pitch_rad)
                     + imu.my * cosf(roll_rad)
                     - imu.mz * sinf(roll_rad) * cosf(pitch_rad);

    imu.yaw = atan2f(-mag_y_comp, mag_x_comp) * 57.2958f;
    if (imu.yaw < 0) imu.yaw += 360.0f;

    printf("Acc[g]: %.2f %.2f %.2f | Gyro[°/s]: %.2f %.2f %.2f | Mag[µT]: %.2f %.2f %.2f | Pitch: %.2f Roll: %.2f Yaw: %.2f\r\n",
           imu.ax, imu.ay, imu.az,
           imu.gx, imu.gy, imu.gz,
           imu.mx, imu.my, imu.mz,
           imu.pitch, imu.roll, imu.yaw);
}
