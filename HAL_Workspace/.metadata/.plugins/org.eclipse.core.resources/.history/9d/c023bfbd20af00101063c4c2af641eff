#include "mpu9250.h"

MPU9250_Data imu;
uint8_t mpu_raw[14];
uint8_t mag_raw[7];

void mpu9250_init(I2C_HandleTypeDef *hi2c)
{
    uint8_t check;

    // Check MPU9250 presence
    HAL_I2C_Mem_Read(hi2c, MPU9250_ADDR, WHO_AM_I_REG, I2C_MEMADD_SIZE_8BIT, &check, 1, HAL_MAX_DELAY);
    if(check != 0x71) { printf("MPU9250 not found!\r\n"); return; }
    printf("MPU9250 detected!\r\n");

    // Wake up MPU9250
    HAL_I2C_Mem_Write(hi2c, MPU9250_ADDR, PWR_MGMT_1_REG, I2C_MEMADD_SIZE_8BIT, (uint8_t[]){0x00}, 1, HAL_MAX_DELAY);
    HAL_Delay(100);

    // Enable I2C bypass for magnetometer
    HAL_I2C_Mem_Write(hi2c, MPU9250_ADDR, INT_PIN_CFG, I2C_MEMADD_SIZE_8BIT, (uint8_t[]){0x02}, 1, HAL_MAX_DELAY);

    // Check AK8963 WHO_AM_I
    uint8_t mag_id;
    HAL_I2C_Mem_Read(hi2c, AK8963_ADDR, AK8963_WHO_AM_I, I2C_MEMADD_SIZE_8BIT, &mag_id, 1, HAL_MAX_DELAY);
    if(mag_id != 0x48) { printf("Magnetometer not found!\r\n"); return; }
    printf("Magnetometer detected!\r\n");
}

void mpu9250_read_accel_gyro(I2C_HandleTypeDef *hi2c)
{
    HAL_I2C_Mem_Read(hi2c, MPU9250_ADDR, ACCEL_XOUT_H_REG, I2C_MEMADD_SIZE_8BIT, mpu_raw, 14, HAL_MAX_DELAY);

    int16_t ax = (mpu_raw[0] << 8) | mpu_raw[1];
    int16_t ay = (mpu_raw[2] << 8) | mpu_raw[3];
    int16_t az = (mpu_raw[4] << 8) | mpu_raw[5];
    int16_t gx = (mpu_raw[8] << 8) | mpu_raw[9];
    int16_t gy = (mpu_raw[10] << 8) | mpu_raw[11];
    int16_t gz = (mpu_raw[12] << 8) | mpu_raw[13];

    imu.ax = ax / 16384.0f;
    imu.ay = ay / 16384.0f;
    imu.az = az / 16384.0f;
    imu.gx = gx / 131.0f;
    imu.gy = gy / 131.0f;
    imu.gz = gz / 131.0f;
}

void mpu9250_read_mag(I2C_HandleTypeDef *hi2c)
{
    uint8_t st1;
    HAL_I2C_Mem_Read(hi2c, AK8963_ADDR, AK8963_ST1, I2C_MEMADD_SIZE_8BIT, &st1, 1, HAL_MAX_DELAY);
    if(st1 & 0x01) {
        HAL_I2C_Mem_Read(hi2c, AK8963_ADDR, AK8963_XOUT_L, I2C_MEMADD_SIZE_8BIT, mag_raw, 7, HAL_MAX_DELAY);
        imu.mx = (mag_raw[2] << 8) | mag_raw[1];
        imu.my = (mag_raw[4] << 8) | mag_raw[3];
        imu.mz = (mag_raw[6] << 8) | mag_raw[5];
    }
}

void mpu9250_compute_orientation(void)
{
    imu.pitch = atan2f(imu.ay, sqrtf(imu.ax*imu.ax + imu.az*imu.az)) * 57.2958f;
    imu.roll  = atan2f(-imu.ax, imu.az) * 57.2958f;

    float pitch_rad = imu.pitch * (M_PI/180.0f);
    float roll_rad  = imu.roll  * (M_PI/180.0f);

    float mag_x_comp = imu.mx*cosf(pitch_rad) + imu.mz*sinf(pitch_rad);
    float mag_y_comp = imu.mx*sinf(roll_rad)*sinf(pitch_rad) + imu.my*cosf(roll_rad) - imu.mz*sinf(roll_rad)*cosf(pitch_rad);

    imu.yaw = atan2f(-mag_y_comp, mag_x_comp) * 57.2958f;
    if(imu.yaw < 0) imu.yaw += 360.0f;
}
